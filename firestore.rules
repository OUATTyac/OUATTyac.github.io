rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /portfolio/data {
      // Anyone can read the portfolio data
      allow read: if true;
      // Only the authenticated admin can write
      allow write: if request.auth != null && request.auth.token.email == 'ouattyac95@gmail.com' && request.auth.token.email_verified == true;
    }
  }
}
